rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isOwner()  { return signedIn() && role() == 'owner'; }
    function isAdmin()  { return signedIn() && role() in ['admin', 'owner']; }
    function isEditor() { return signedIn() && role() in ['editor', 'admin', 'owner']; }

    // https adresi VEYA sürükle-bırak ile yüklenen küçültülmüş JPEG (data:image/jpeg;base64,...)
    function validUrl(u) {
      return u is string
        && ((u.matches('^https://.+') && u.size() <= 500)
            || (u.matches('^data:image/jpeg;base64,.+') && u.size() <= 900000));
    }
    function txt(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    // "alan varsa geçerli olmalı" yardımcıları
    function optTxt(d, k, max) { return !(k in d) || txt(d[k], max); }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optOrder(d)       { return !('order' in d) || d.order is number; }
    function okAge(d)          { return !('age' in d) || (d.age is int && d.age >= 10 && d.age <= 99); }
    // İsim/yaş bir kez ayarlandıktan sonra KİLİTLENİR: değiştirmek için owner gerekir (onaylı talep)
    function nameLocked(d)     { return 'name' in d || 'age' in d; }

    // Duyurular: herkes okur; editor/admin/owner ekler ve siler. authorUid sadece panelde isme çevrilir.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['title', 'content', 'titleEn', 'contentEn', 'imageUrl', 'authorUid', 'createdAt'])
        && txt(request.resource.data.title, 120)
        && txt(request.resource.data.content, 3000)
        && optStr(request.resource.data, 'titleEn', 120)
        && optStr(request.resource.data, 'contentEn', 3000)
        && (request.resource.data.imageUrl == '' || validUrl(request.resource.data.imageUrl))
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isEditor();
      allow update: if false;
    }

    // Partnerler
    match /partners/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'imageUrl', 'order', 'createdAt'])
        && txt(request.resource.data.name, 80)
        && validUrl(request.resource.data.imageUrl)
        && request.resource.data.order is number
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'imageUrl', 'order'])
        && optTxt(request.resource.data, 'name', 80)
        && (!('imageUrl' in request.resource.data) || validUrl(request.resource.data.imageUrl))
        && optOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    // Galeri
    match /gallery/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['url', 'order', 'createdAt'])
        && validUrl(request.resource.data.url)
        && request.resource.data.order is number
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Yönetim kadrosu
    match /staff/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'icon', 'role', 'roleEn', 'order', 'createdAt'])
        && txt(request.resource.data.name, 80)
        && request.resource.data.icon in ['fa-crown', 'fa-users', 'fa-code', 'fa-user-tie', 'fa-headset', 'fa-truck']
        && request.resource.data.role is string && request.resource.data.role.size() <= 120
        && request.resource.data.roleEn is string && request.resource.data.roleEn.size() <= 120
        && request.resource.data.order is number
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'icon', 'role', 'roleEn', 'order'])
        && optTxt(request.resource.data, 'name', 80)
        && (!('icon' in request.resource.data)
            || request.resource.data.icon in ['fa-crown', 'fa-users', 'fa-code', 'fa-user-tie', 'fa-headset', 'fa-truck'])
        && optStr(request.resource.data, 'role', 120)
        && optStr(request.resource.data, 'roleEn', 120)
        && optOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    // Bakım modu: herkes okur, SADECE owner değiştirir
    match /settings/maintenance {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['on', 'until', 'updatedAt'])
        && request.resource.data.on is bool
        && request.resource.data.until is string && request.resource.data.until.size() <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Popup (ana sayfadaki açılır pencere): herkes okur, SADECE owner değiştirir
    match /settings/popup {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['on', 'text', 'textEn', 'imageUrl', 'v', 'updatedAt'])
        && request.resource.data.on is bool
        && request.resource.data.text is string && request.resource.data.text.size() <= 140
        && request.resource.data.textEn is string && request.resource.data.textEn.size() <= 280
        && (request.resource.data.imageUrl == '' || validUrl(request.resource.data.imageUrl))
        && request.resource.data.v is number
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Eski (koda gömülü) kartların veritabanına aktarıldığını gösteren işaretler
    match /settings/{flag} {
      allow read: if true;
      allow create: if isAdmin()
        && flag in ['seed_staff', 'seed_partners', 'seed_gallery']
        && request.resource.data.keys().hasOnly(['done', 'at'])
        && request.resource.data.done == true
        && request.resource.data.at == request.time;
    }

    // İsim/yaş değişiklik talepleri: yetkili kendi talebini yazar, SADECE owner onaylar/reddeder
    match /nameRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if request.auth.uid == uid && isEditor()
        && request.resource.data.keys().hasOnly(['name', 'age', 'status', 'createdAt'])
        && txt(request.resource.data.name, 40)
        && request.resource.data.age is int && request.resource.data.age >= 10 && request.resource.data.age <= 99
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'rejected';
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }

    // Kullanıcılar ve roller
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Kayıt olurken sadece "user" rolüyle kendi kaydını oluşturabilir
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.keys().hasOnly(['email', 'role']);
      // Admin/owner: başkasının rolünü, ismini ve yaşını değiştirir. OWNER'ın kaydı panelden değiştirilemez.
      // "owner" rolünü sadece bir owner verebilir.
      allow update: if isAdmin()
                    && resource.data.role != 'owner'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name', 'age'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'age'])
                        || isOwner() || !nameLocked(resource.data))
                    && optTxt(request.resource.data, 'name', 40)
                    && okAge(request.resource.data)
                    && (request.resource.data.role in ['user', 'editor', 'admin']
                        || (request.resource.data.role == 'owner' && isOwner()));
      // Yetkililer (editor/admin/owner) sadece KENDİ isim ve yaşlarını değiştirebilir
      allow update: if request.auth.uid == uid && isEditor()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'age'])
                    && (isOwner() || !nameLocked(resource.data))
                    && optTxt(request.resource.data, 'name', 40)
                    && okAge(request.resource.data);
      allow delete: if false;
    }
  }
}
